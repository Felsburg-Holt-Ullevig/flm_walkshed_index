{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,159}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scalar": {
      "type": "number",
      "minimum": 0
    },
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "coordinate": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "coverage": {
      "type": "object",
      "properties": {
        "core_bbox": {
          "$ref": "common.schema.json#/$defs/bbox"
        },
        "extract_bbox": {
          "$ref": "common.schema.json#/$defs/bbox"
        },
        "selection": {
          "enum": ["node_inside_complete_way", "synthetic_closed"]
        },
        "readiness": {
          "enum": ["not_established", "synthetic_closed"]
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/text"
          }
        }
      },
      "required": ["core_bbox", "extract_bbox", "selection", "readiness", "limitations"],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "graph_format": {
          "const": "flm-directed-graph-1"
        },
        "rule_version": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "scenario_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "rule_sha256": {
          "$ref": "common.schema.json#/$defs/sha"
        },
        "code_sha256": {
          "$ref": "common.schema.json#/$defs/sha"
        },
        "config_sha256": {
          "$ref": "common.schema.json#/$defs/sha"
        },
        "source_inventory_sha256": {
          "$ref": "common.schema.json#/$defs/sha"
        },
        "length_model": {
          "enum": ["wgs84_geodesic_international_ft", "synthetic_declared_ft"]
        },
        "seconds_per_foot": {
          "const": 0.24384
        }
      },
      "required": [
        "graph_format",
        "rule_version",
        "scenario_id",
        "rule_sha256",
        "code_sha256",
        "config_sha256",
        "source_inventory_sha256",
        "length_model",
        "seconds_per_foot"
      ],
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "unknown_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unsupported_restrictions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unresolved_relation_members": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/text"
          }
        },
        "analytical_promotion": {
          "const": "blocked_experimental"
        }
      },
      "required": [
        "unknown_candidates",
        "unsupported_restrictions",
        "unresolved_relation_members",
        "blockers",
        "analytical_promotion"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://schemas.flm.example/network-package/v1/common.schema.json"
}
