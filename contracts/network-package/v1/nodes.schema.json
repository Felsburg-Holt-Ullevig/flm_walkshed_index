{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "flm-nodes-1"
    },
    "release_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "graph_id": {
      "$ref": "common.schema.json#/$defs/sha"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "$ref": "common.schema.json#/$defs/source_id"
          },
          "coordinate": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": ["node_id", "coordinate"],
        "additionalProperties": false
      },
      "maxItems": 600000
    }
  },
  "required": ["schema_version", "release_id", "graph_id", "nodes"],
  "additionalProperties": false,
  "$id": "https://schemas.flm.example/network-package/v1/nodes.schema.json"
}
