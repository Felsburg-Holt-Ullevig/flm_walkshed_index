{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flm.example/walk-tiles/v0/tile.schema.json",
  "$defs": {
    "segment": { "$ref": "segment.schema.json#/$defs/segment" }
  },
  "type": "object",
  "properties": {
    "col": { "type": "integer", "minimum": 0, "maximum": 35999 },
    "row": { "type": "integer", "minimum": 0, "maximum": 17999 },
    "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/segment" } }
  },
  "required": ["col", "row", "segments"],
  "additionalProperties": false
}
